# ============================================================
#  MAMAR — configuration
#  Copy this file to ".env" and fill in your own values:
#      cp .env.example .env
#  The real .env is gitignored — NEVER commit it.
# ============================================================

# Which AI provider supplies MAMAR's brain.
#   openai  -> OpenAI (GPT models)
#   xai     -> xAI (Grok models) — same code, different address + key
#   demo    -> no real AI; canned replies that say they are demo replies
# If no API key is set, MAMAR runs in demo mode no matter what this says.
MAMAR_PROVIDER=demo

# Your API key for the provider above. Get one from the provider's
# dashboard (platform.openai.com or console.x.ai). Keep it secret.
MAMAR_API_KEY=

# Which model to ask for. Defaults: openai -> gpt-4o-mini, xai -> grok-4.
# Set this to use a different one, e.g. gpt-4o or grok-4-fast.
MAMAR_MODEL=

# Optional: override the provider's API address. Leave empty for the
# normal OpenAI / xAI addresses. Only needed for an OpenAI-compatible
# service hosted somewhere else.
MAMAR_BASE_URL=
