# ============================================================
#  VEGA — configuration
#  Copy this file to ".env" and fill in your own values:
#      cp .env.example .env
#  The real .env is gitignored — NEVER commit it.
# ============================================================

# Which AI provider supplies VEGA's brain.
#   openai  -> OpenAI (GPT models) — cloud, needs an API key
#   xai     -> xAI (Grok models) — cloud, needs an API key
#   ollama  -> a model running on THIS machine via Ollama — free,
#              offline, and NO API key needed (see below)
#   demo    -> no real AI; canned replies that say they are demo replies
# Cloud providers run in demo mode if no API key is set. Ollama only
# needs to be selected — and actually running.
VEGA_PROVIDER=demo

# Your API key for the provider above. Get one from the provider's
# dashboard (platform.openai.com or console.x.ai). Keep it secret.
# Not used at all when VEGA_PROVIDER=ollama.
VEGA_API_KEY=

# Which model to ask for. Defaults: openai -> gpt-4o-mini,
# xai -> grok-4, ollama -> llama3.1:8b.
# Set this to use a different one, e.g. gpt-4o or grok-4-fast.
VEGA_MODEL=

# Optional: override the provider's API address. Leave empty for the
# normal addresses (Ollama's is http://127.0.0.1:11434/v1). Only needed
# for an OpenAI-compatible service hosted somewhere else.
VEGA_BASE_URL=

# ------------------------------------------------------------
#  LOCAL BRAIN (Ollama) — the free, offline option
#  1. Install Ollama from https://ollama.com
#  2. Download the model:        ollama pull llama3.1:8b
#     (qwen2.5:7b is a good alternative pick)
#  3. Make sure Ollama is running (open the app, or: ollama serve)
#  4. Set:  VEGA_PROVIDER=ollama
#           VEGA_MODEL=llama3.1:8b
#  That's it — no key, no bills, works with the Wi-Fi off.
# ------------------------------------------------------------
